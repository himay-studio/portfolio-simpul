# R36 shared Himay tracking pixel (not a secret, same value already set as
# the server-side META_PIXEL_ID Pages env var used by functions/api/meta-events.ts).
# This is the missing client-build half: Next.js only inlines NEXT_PUBLIC_*
# vars that are present at `next build` time, and this one was never set
# anywhere in the fleet, so the client Meta Pixel (and its CAPI companion
# call, both gated on this constant) have never actually fired in production.
# See HIM-356.
NEXT_PUBLIC_META_PIXEL_ID=1837485590560640
